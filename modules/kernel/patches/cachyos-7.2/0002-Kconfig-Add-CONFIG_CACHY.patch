From c74130de6b69d0517a766c9297aac749a0304bad Mon Sep 17 00:00:00 2001
From: Eric Naim <dnaim@cachyos.org>
Date: Wed, 25 Mar 2026 03:38:24 +0800
Subject: [PATCH 002/243] Kconfig: Add CONFIG_CACHY

This will be used later on for the tweaks made to kernel.

Signed-off-by: Eric Naim <dnaim@cachyos.org>
---
 init/Kconfig | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/init/Kconfig b/init/Kconfig
index 5230d4879b1c..8e5b537475f9 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -215,6 +215,10 @@ config THREAD_INFO_IN_TASK
 
 menu "General setup"
 
+config CACHY
+	bool "Kernel tweaks by CachyOS"
+	default y
+
 config BROKEN
 	bool
 	help
-- 
