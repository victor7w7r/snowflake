 	}
 
 	if (ch_info->ch_band == RTW89_BAND_6G) {
@@ -10277,6 +10397,10 @@ int rtw89_hw_scan_start(struct rtw89_dev *rtwdev,
 	rtwdev->scan_info.delay = 0;
 	rtwvif->scan_ies = &scan_req->ies;
