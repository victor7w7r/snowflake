From ae44a037ac03d7f8bc8a17da02163c7f5c63bf50 Mon Sep 17 00:00:00 2001
From: Yury Norov <ynorov@nvidia.com>
Date: Sun, 19 Jul 2026 08:27:27 -0400
Subject: [PATCH 06600/15333] bitmap: drop bitmap_next_set_region()

The function is a dead code. Drop it.

Signed-off-by: Yury Norov <ynorov@nvidia.com>
---
 include/linux/bitmap.h | 8 --------
 1 file changed, 8 deletions(-)

diff --git a/include/linux/bitmap.h b/include/linux/bitmap.h
index 8854acf77869..a967e1f7542b 100644
--- a/include/linux/bitmap.h
+++ b/include/linux/bitmap.h
@@ -697,14 +697,6 @@ void bitmap_gather(unsigned long *dst, const unsigned long *src,
 		__assign_bit(n++, dst, test_bit(bit, src));
 }
 
-static __always_inline
-void bitmap_next_set_region(unsigned long *bitmap, unsigned int *rs,
-			    unsigned int *re, unsigned int end)
-{
-	*rs = find_next_bit(bitmap, end, *rs);
-	*re = find_next_zero_bit(bitmap, end, *rs + 1);
-}
-
 /**
  * bitmap_release_region - release allocated bitmap region
  *	@bitmap: array of unsigned longs corresponding to the bitmap
