From e483d197f78adbf02f23cc54f3da8b4bb048df5b Mon Sep 17 00:00:00 2001
From: David Heidelberg <david@ixit.cz>
Date: Fri, 12 Dec 2025 16:34:33 +0100
Subject: [PATCH 15234/15333] arm64: dts: qcom: sdm845-google: Enable fuel
 gauge

Enable the fuel gauge and configure the associated charger and battery.

Signed-off-by: David Heidelberg <david@ixit.cz>
---
 arch/arm64/boot/dts/qcom/sdm845-google-common.dtsi | 13 ++++++-------
 1 file changed, 6 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sdm845-google-common.dtsi b/arch/arm64/boot/dts/qcom/sdm845-google-common.dtsi
index 658245dbb473..82f0c2e95bcb 100644
--- a/arch/arm64/boot/dts/qcom/sdm845-google-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sdm845-google-common.dtsi
@@ -666,12 +666,6 @@ &pmi8998_fg {
 	status = "okay";
 };
 
-&pmi8998_haptics {
-	qcom,wave-play-rate-us = <6667>;
-
-	status = "okay";
-};
-
 &pmi8998_flash {
 	status = "okay";
 
@@ -696,7 +690,12 @@ led-1 {
 		flash-max-timeout-us = <1280000>;
 		function-enumerator = <1>;
 	};
->>>>>>> 754cfabdf97aa (arm64: dts: qcom: sdm845-google: Enable PMI8998 camera flash LEDs)
+};
+
+&pmi8998_haptics {
+	qcom,wave-play-rate-us = <6667>;
+
+	status = "okay";
 };
 
 &qupv3_id_0 {
