-static int quicktest0(unsigned long arg)
-{
-	unsigned long word0;
-	unsigned long word1;
-	void *cb;
-	void *dsr;
-	unsigned long *p;
-	int ret = -EIO;
-
-	if (gru_get_cpu_resources(GRU_CACHE_LINE_BYTES, &cb, &dsr))
