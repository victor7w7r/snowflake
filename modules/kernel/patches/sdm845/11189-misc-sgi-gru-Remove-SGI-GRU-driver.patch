-/*----------------- RESOURCE MANAGEMENT -------------------------------------*/
-/* optimized for x86_64 */
-struct message_queue {
-	union gru_mesqhead	head __gru_cacheline_aligned__;	/* CL 0 */
-	int			qlines;				/* DW 1 */
-	long 			hstatus[2];
-	void 			*next __gru_cacheline_aligned__;/* CL 1 */
-	void 			*limit;
-	void 			*start;
-	void 			*start2;
-	char			data ____cacheline_aligned;	/* CL 2 */
