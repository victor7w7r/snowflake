+++ /dev/null
@@ -1,969 +0,0 @@
-// SPDX-License-Identifier: GPL-2.0-or-later
-/*
- * SN Platform GRU Driver
- *
- *            DRIVER TABLE MANAGER + GRU CONTEXT LOAD/UNLOAD
- *
