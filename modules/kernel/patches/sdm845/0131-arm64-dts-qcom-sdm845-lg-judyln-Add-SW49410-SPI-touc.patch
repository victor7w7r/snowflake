From 94eb9499bd525a14ad931034d8264f4ccf52cff4 Mon Sep 17 00:00:00 2001
From: Paul Sajna <sajattack@postmarketos.org>
Date: Wed, 3 Jun 2026 21:15:01 -0700
Subject: [PATCH 131/212] arm64: dts: qcom: sdm845-lg-judyln: Add SW49410 SPI
 touchscreen nodes

Add the SPI node, SPI QUP, and SW49410 touchscreen node to the
LG G7 ThinQ devicetree

Signed-off-by: Paul Sajna <sajattack@postmarketos.org>
---
 arch/arm64/boot/dts/qcom/sdm845-lg-judyln.dts | 24 +++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sdm845-lg-judyln.dts b/arch/arm64/boot/dts/qcom/sdm845-lg-judyln.dts
index 52625571d298..1b0145652e26 100644
--- a/arch/arm64/boot/dts/qcom/sdm845-lg-judyln.dts
+++ b/arch/arm64/boot/dts/qcom/sdm845-lg-judyln.dts
@@ -148,6 +148,30 @@ &pmi8998_fg {
 	status = "okay";
 };
 
+&qup_spi5_default {
+	drive-strength = <6>;
+	bias-disable;
+
+	status = "okay";
+};
+
+&spi5 {
+	clock-frequency = <5000000>;
+
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "siw,sw49410-ts-spi";
+		reg = <0>;
+		interrupts-extended = <&tlmm 31 IRQ_TYPE_EDGE_FALLING>;
+		spi-max-frequency = <5000000>;
+		reset-gpio = <&tlmm 32 GPIO_ACTIVE_LOW>;
+		panel = <&display_panel>;
+		touchscreen-size-x = <1440>;
+		touchscreen-size-y = <3120>;
+	};
+};
+
 &tlmm {
 	thinq_key_default: thinq-key-default-state {
 		pins = "gpio89";
-- 
2.55.0

