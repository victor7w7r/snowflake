 .../tests/amdgpu_dm_connector_test.c          |  64 +++++++----
 .../tests/amdgpu_dm_mst_types_test.c          | 104 ++++++++++--------
 .../amdgpu_dm/tests/amdgpu_dm_plane_test.c    |  99 ++++++++++-------
 .../display/amdgpu_dm/tests/amdgpu_dm_test.c  |  72 +++++++-----
 5 files changed, 208 insertions(+), 134 deletions(-)

