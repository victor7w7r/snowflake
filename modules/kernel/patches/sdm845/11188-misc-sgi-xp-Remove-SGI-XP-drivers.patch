-static void
-xpc_hb_beater(struct timer_list *unused)
-{
-	xpc_arch_ops.increment_heartbeat();
-
-	if (time_is_before_eq_jiffies(xpc_hb_check_timeout))
-		wake_up_interruptible(&xpc_activate_IRQ_wq);
