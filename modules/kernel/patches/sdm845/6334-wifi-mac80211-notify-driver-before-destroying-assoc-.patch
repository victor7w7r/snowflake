 			drv_event_callback(sdata->local, sdata, &event);
@@ -9127,7 +9132,8 @@ void ieee80211_sta_work(struct ieee80211_sub_if_data *sdata)
 				.u.mlme.status = MLME_TIMEOUT,
 			};
 
-			ieee80211_destroy_assoc_data(sdata, ASSOC_TIMEOUT);
+			ieee80211_destroy_assoc_data(sdata, ASSOC_TIMEOUT,
