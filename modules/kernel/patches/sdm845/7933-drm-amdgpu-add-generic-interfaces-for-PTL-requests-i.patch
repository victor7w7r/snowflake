@@ -45,6 +45,7 @@ enum idh_request {
 	IDH_REQ_RAS_BAD_PAGES = 205,
 	IDH_REQ_RAS_CHK_CRITI = 206,
 	IDH_REQ_RAS_REMOTE_CMD = 207,
