From 24104f135725e907d4f2b11851a1e68dc0d3c31d Mon Sep 17 00:00:00 2001
From: David Heidelberg <david@ixit.cz>
Date: Sun, 9 Aug 2026 14:04:56 +0200
Subject: [PATCH 212/212] arm64: dts: qcom: sdm845-xiaomi-dipper: Add
 touchscreen

The Mi 8 uses an ST FingerTipS FTM5 controller on I2C14, with the
interrupt on GPIO 31 and reset on GPIO 32.  Its bus supply is the same
display module 1.8 V rail that already exists in the DT, so give that
regulator a label.

Signed-off-by: David Heidelberg <david@ixit.cz>
Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../dts/qcom/sdm845-xiaomi-dipper-common.dtsi | 27 +++++++++++++++++--
 1 file changed, 25 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sdm845-xiaomi-dipper-common.dtsi b/arch/arm64/boot/dts/qcom/sdm845-xiaomi-dipper-common.dtsi
index ae3c3613ad93..2eb40897b2ad 100644
--- a/arch/arm64/boot/dts/qcom/sdm845-xiaomi-dipper-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sdm845-xiaomi-dipper-common.dtsi
@@ -86,7 +86,7 @@ vreg_panel_vci: regulator-panel-vci {
 		regulator-boot-on;
 	};
 
-	regulator-panel-vddio {
+	vreg_panel_vddio: regulator-panel-vddio {
 		compatible = "regulator-fixed";
 		regulator-name = "panel_vddio_vreg";
 
@@ -559,7 +559,23 @@ &i2c14 {
 
 	status = "okay";
 
-	/* stmfts5 @49 */
+	touchscreen@49 {
+		compatible = "st,stmfts5";
+		reg = <0x49>;
+
+		interrupts-extended = <&tlmm 31 IRQ_TYPE_LEVEL_LOW>;
+
+		reset-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
+
+		avdd-supply = <&vreg_l28a_3p3>;
+		vdd-supply = <&vreg_panel_vddio>;
+
+		touchscreen-size-x = <1080>;
+		touchscreen-size-y = <2248>;
+
+		pinctrl-0 = <&ts_default>;
+		pinctrl-names = "default";
+	};
 };
 
 &tlmm {
@@ -581,6 +597,13 @@ te-pins {
 			bias-pull-down;
 		};
 	};
+
+	ts_default: ts-default-state {
+		pins = "gpio31", "gpio32";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-pull-up;
+	};
 };
 
 &ufs_mem_hc {
-- 
2.55.0

