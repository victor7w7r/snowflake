From dbe8583e5af9c26d3377aa692c9f18d71a38bb40 Mon Sep 17 00:00:00 2001
From: Frieder Hannenheim <git@fhannenheim.net>
Date: Tue, 1 Sep 2026 18:26:46 +0200
Subject: [PATCH 205/212] media: dt-bindings: media: Add LC898219XI compatible

The LC898219XI is a closed loop auto focus controller from the same
family as the LC898217XC. Both are supplied from a single VDD rail and
share the driver, so add the compatible to the existing binding.

Signed-off-by: Frieder Hannenheim <git@fhannenheim.net>
---
 .../devicetree/bindings/media/i2c/onnn,lc898217xc.yaml      | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/media/i2c/onnn,lc898217xc.yaml b/Documentation/devicetree/bindings/media/i2c/onnn,lc898217xc.yaml
index ef8139d8e66a..373fd7130f80 100644
--- a/Documentation/devicetree/bindings/media/i2c/onnn,lc898217xc.yaml
+++ b/Documentation/devicetree/bindings/media/i2c/onnn,lc898217xc.yaml
@@ -5,13 +5,14 @@
 $id: http://devicetree.org/schemas/media/i2c/onnn,lc898217xc.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: ON Semiconductor LC898217XC Voice Coil Motor (VCM) Lens
+title: ON Semiconductor LC89821X Voice Coil Motor (VCM) Lens
 
 maintainers:
   - Vasiliy Doylov <nekocwd@mainlining.org>
 
 description:
-  The LC898217XC is a 11-bit digital-to-analog (DAC) converter.
+  The LC898217XC is a 11-bit and the LC898219XI a 12-bit digital-to-analog
+  (DAC) converter.
   VCM current is controlled with a linear mode driver.The DAC is controlled
   via a 2-wire (I2C-compatible) serial interface that operates at clock
   rates up to 1MHz. This chip integrates Advanced Actuator Control (AAC)
@@ -21,6 +22,7 @@ properties:
   compatible:
     enum:
       - onnn,lc898217xc
+      - onnn,lc898219xi
 
   reg:
     maxItems: 1
-- 
2.55.0

