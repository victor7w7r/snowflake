 tools/perf/ui/browsers/Build          |   1 +
 tools/perf/ui/browsers/c2c-function.c | 209 ++++++++++++++++++++++++++
 tools/perf/util/c2c.h                 |  22 +++
 4 files changed, 242 insertions(+)
