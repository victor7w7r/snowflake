+/***********************************************************************************/
+/* TFA9873						                                                    */
+static enum tfa_error tfa9873_specific(struct tfa_device *tfa)
+{
+	enum tfa_error error;
+
+	error = tfa_unlock_keys(tfa);
+	if (error)
