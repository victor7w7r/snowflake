+#ifndef TFACONTAINER_H_
+#define TFACONTAINER_H_
+
+/* static limits */
+#define TFACONT_MAXPROFS (16) /* maximum nr of profiles */
+
+#include "tfa98xx_parameters.h"
+
+enum tfa_error tfaRunWriteBitfield(struct tfa_device *tfa, struct TfaBitfield bf);
+enum tfa_error tfa_cont_write_filterbank(struct tfa_device *tfa, struct TfaFilter *filter);
