+static enum tfa_error tfa_auto_copy_mtp_to_iic(struct tfa_device *tfa)
+{
+	/* Set auto_copy_mtp_to_iic (bit 5 of A3) to 1 (PLMA5290 workaround) */
+	return tfa_reg_write(tfa, 0xA3, 0x20);
+}
