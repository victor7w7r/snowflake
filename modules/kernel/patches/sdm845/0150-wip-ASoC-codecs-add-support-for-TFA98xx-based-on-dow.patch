+static enum tfa_error tfa_generic_faim_protect(struct tfa_device *tfa,
+					       int state)
+{
+	if (tfa->bf.openmtp)
+		return tfa_set_bf_volatile(tfa, tfa->bf.openmtp,
+					   (uint16_t)state);
+	return tfa_error_ok;
+}
+
+static enum tfa_error tfa_generic_dsp_system_stable(struct tfa_device *tfa,
+						    int *ready)
+{
+	int value = tfa_get_bf(tfa, tfa->bf.clks);
+
+	*ready = (value == 1);
+	return tfa_error_ok;
+}
+
+static enum tfa_error tfa_unlock_keys(struct tfa_device *tfa)
+{
+	enum tfa_error error;
+	unsigned short value, xor;
+
+	error = tfa_reg_write(tfa, 0x0F, 0x5A6B);
+	if (error)
+		return error;
+	error = tfa_reg_read(tfa, 0xFB, &value);
+	if (error)
+		return error;
+	xor = value ^ 0x005A;
+	error = tfa_reg_write(tfa, 0xA0, xor);
+	if (error)
+		return error;
+	tfa98xx_key2(tfa, 0);
+
+	return tfa_error_ok;
+}
