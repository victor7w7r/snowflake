+static int tfa_generic_set_swprofile(struct tfa_device *tfa,
+				     unsigned short new_value)
+{
+	int active_value = tfa_dev_get_swprof(tfa);
+
+	tfa->profile = new_value - 1;
+	tfa_set_bf_volatile(tfa, tfa->bf.swprofil, new_value);
+
+	return active_value;
+}
+
+static int tfa_generic_get_swprofile(struct tfa_device *tfa)
+{
+	return (tfa_get_bf(tfa, tfa->bf.swprofil)) - 1;
+}
+
+static int tfa_generic_set_swvstep(struct tfa_device *tfa,
+				   unsigned short new_value)
+{
+	int active_value = tfa->vstep;
+
+	tfa->vstep = new_value - 1;
+	tfa_set_bf_volatile(tfa, tfa->bf.swvstep, new_value);
+
+	return active_value;
+}
