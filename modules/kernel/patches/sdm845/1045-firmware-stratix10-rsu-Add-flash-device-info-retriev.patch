 .../firmware/intel/stratix10-svc-client.h     |  12 +-
 4 files changed, 315 insertions(+), 16 deletions(-)

diff --git a/drivers/firmware/stratix10-rsu.c b/drivers/firmware/stratix10-rsu.c
