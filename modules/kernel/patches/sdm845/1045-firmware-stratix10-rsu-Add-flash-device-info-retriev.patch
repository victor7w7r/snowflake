 static DEVICE_ATTR_RO(spt0_address);
@@ -764,6 +935,14 @@ static struct attribute *rsu_attrs[] = {
 	&dev_attr_dcmf1_status.attr,
 	&dev_attr_dcmf2_status.attr,
