 arch/arm/arm-soc-for-next-contents.txt | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/arch/arm/arm-soc-for-next-contents.txt b/arch/arm/arm-soc-for-next-contents.txt
index 30c2012645df..e50a879a7c40 100644
