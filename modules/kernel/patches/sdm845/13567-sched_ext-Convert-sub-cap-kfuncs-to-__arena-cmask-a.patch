 kernel/sched/ext/ext.c                   |  8 ++--
 kernel/sched/ext/sub.c                   | 49 ++++++++++++------------
 kernel/sched/ext/types.h                 |  6 +--
 tools/sched_ext/include/scx/common.bpf.h | 11 +++---
 tools/sched_ext/scx_qmap.bpf.c           | 20 +++++-----
 6 files changed, 51 insertions(+), 54 deletions(-)

