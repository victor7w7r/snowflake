 .../dts/exynos/google/gs101-pixel-common.dtsi | 12 +++-
 .../boot/dts/exynos/google/gs101-raven.dts    |  2 +
 arch/arm64/boot/dts/exynos/google/gs101.dtsi  | 70 +++++++++++++++++++
 4 files changed, 85 insertions(+), 1 deletion(-)

