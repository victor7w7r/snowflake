+struct rxpd {
+	u8 bss_type;
+	u8 bss_num;
+	__le16 rx_pkt_length;
+	__le16 rx_pkt_offset;
+	__le16 rx_pkt_type;
+	__le16 seq_num;
+	u8 priority;
+	u8 rx_rate;
+	s8 snr;
+	s8 nf;
+	/*
+	 * rate_info bit definition (FW encoded)
+	 *
+	 * [1:0]  format
+	 *        00 = legacy
+	 *        01 = HT
+	 *        10 = VHT
+	 *        11 = HE
+	 *
+	 * [3:2]  bandwidth
+	 *        00 = 20 MHz
+	 *        01 = 40 MHz
+	 *        10 = 80 MHz
+	 *        11 = 160 MHz
+	 *
+	 * [4]    GI (HT/VHT) / HE GI LSB
+	 *        HT/VHT:
+	 *          0 = LGI
+	 *          1 = SGI
+	 *
+	 *        HE:
+	 *          used as GI[0]
+	 *
+	 * [5]    STBC
+	 *        0 = no STBC
+	 *        1 = STBC enabled
+	 *
+	 * [6]    LDPC
+	 *        0 = BCC
+	 *        1 = LDPC
+	 *
+	 * [7]    HE GI MSB
+	 *
+	 * HE GI encoding (combined from bit7:bit4):
+	 *        GI[1:0] = {bit7, bit4}
+	 *
+	 *        00 = 0.8 us
+	 *        01 = 1.6 us
+	 *        10 = 3.2 us
+	 *        11 = reserved / undefined
+	 */
+	u8 rate_info;
+	u8 reserved[3];
+	u8 flags;
+	u8 antenna;
+	/* toa_tod_tstamps: [31:0] ToA, [63:32] ToD (ns). */
+	__le64 toa_tod_tstamps;
+	/* rx info */
+	__le32 rx_info;
+	/* Reserved */
+	u8  reserved3[8];
+	u8 ta_mac[6];
+	u8 reserved4[2];
+} __packed;
