+	pipe_mcache_regs->main.p1.mcache_id_first = MCACHE_ID_UNASSIGNED;
+	pipe_mcache_regs->main.p1.mcache_id_second = MCACHE_ID_UNASSIGNED;
+	pipe_mcache_regs->main.p1.split_location = SPLIT_LOCATION_UNDEFINED;
