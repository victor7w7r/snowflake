+	.get_generic_pin = dal_hw_generic_get_pin,
+	.define_hpd_registers = dcn60_define_hpd_registers,
+	.define_ddc_registers = dcn60_define_ddc_registers,
+	.define_generic_registers = dcn60_define_generic_registers
+};
