+
+bool dcn60_smu_get_dal_init_table(struct clk_mgr_internal *clk_mgr,
+		const DalInitTable_t **init_table)
+{
+	if (!dcn60_smu_transfer_table_smu_2_dram(clk_mgr,
+			TABLE_DAL_INIT, clk_mgr->dal_init_table_addr))
+		return false;
