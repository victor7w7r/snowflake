+bool dmub_dcn60_is_supported(struct dmub_srv *dmub)
+{
+	(void)dmub;
+	// TODO: CC_DC_PIPE_DIS::DC_DMCUB_ENABLE no longer exists
+	//REG_GET(CC_DC_PIPE_DIS, DC_DMCUB_ENABLE, &supported);
+	return 1;
