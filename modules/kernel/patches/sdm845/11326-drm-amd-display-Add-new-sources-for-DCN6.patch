+/* 0 : 1 byte per pix
+ * 1 : 2 byte per pix
+ * 2 : 4 byte per pix
+ * 3 : 8 byte per pix
+ */
+static unsigned int get_element_size_idx(unsigned int byte_per_pix)
+{
+	unsigned int idx = 0;
+
+	while (byte_per_pix > 1) {
+		byte_per_pix >>= 1;
+		idx++;
+	}
+	return idx;
+}
