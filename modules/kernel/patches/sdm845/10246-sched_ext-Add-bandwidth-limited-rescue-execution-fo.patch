 				scx_do_enqueue_task(rq, p, SCX_ENQ_REENQ, -1);
 				p->scx.flags &= ~SCX_TASK_REENQ_REASON_MASK;
 			} else {
+				u64 enq_flags = 0;
+
+				/*
+				 * Keep a preempted rescue going. If preempted
+				 * by another SCX task, append to the local DSQ,
