+		   is_dp_or_hdmi) {
+		encoding_mask = BIT(PIXEL_ENCODING_YCBCR444);
+	} else if (drm_state && drm_state->color_format == DRM_CONNECTOR_COLOR_FORMAT_RGB444) {
+		encoding_mask = BIT(PIXEL_ENCODING_RGB);
