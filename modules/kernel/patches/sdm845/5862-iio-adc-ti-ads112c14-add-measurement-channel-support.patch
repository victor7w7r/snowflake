 /*
  * Available gains as tenths (e.g. value 5 == 0.5 gain). Indexes correspond to
  * ADS112C14_GAIN_CFG_GAIN values.
@@ -204,11 +221,33 @@ static const struct iio_chan_spec ads112c14_sys_mon_channels[] = {
