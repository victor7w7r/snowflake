From a8026b1bb3b1e6ee355a1dbb8f29c2134980f89c Mon Sep 17 00:00:00 2001
From: David Heidelberg <david@ixit.cz>
Date: Wed, 2 Sep 2026 12:16:00 +0200
Subject: [PATCH 015/211] arm64: dts: qcom: sdm845-google: Enable pmi8998
 haptics

Enables phone vibrations. 6667us is ~150Hz, taken from the downstream
Android device-tree.

Co-developed-by: Casey Tunturi <casey.tunturi@gmail.com>
Signed-off-by: David Heidelberg <david@ixit.cz>
---
 arch/arm64/boot/dts/qcom/sdm845-google-common.dtsi | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sdm845-google-common.dtsi b/arch/arm64/boot/dts/qcom/sdm845-google-common.dtsi
index 9e952f9862f2..c2b894d59707 100644
--- a/arch/arm64/boot/dts/qcom/sdm845-google-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sdm845-google-common.dtsi
@@ -454,6 +454,12 @@ &pmi8998_charger {
 	status = "okay";
 };
 
+&pmi8998_haptics {
+	qcom,wave-play-rate-us = <6667>;
+
+	status = "okay";
+};
+
 &qupv3_id_0 {
 	status = "okay";
 };
-- 
2.55.0

