-static int smb2_lease_break_noti(struct oplock_info *opinfo, bool wait_ack,
+static int smb2_lease_break_noti(struct oplock_info *opinfo, bool sync,
 				 bool inc_epoch)
 {
 	struct ksmbd_conn *conn;
