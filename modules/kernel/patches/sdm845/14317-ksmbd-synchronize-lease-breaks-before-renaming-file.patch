 	struct oplock_break_entry *ent, *tmp;
@@ -1736,7 +1747,7 @@ static void __smb_break_all_levII_oplock(struct ksmbd_work *work,
 				     brk_op->is_lease && !is_trunc ?
 				     SMB2_OPLOCK_LEVEL_II : SMB2_OPLOCK_LEVEL_NONE,
 				     send_interim && !sent_interim ? work : NULL,
-				     false);
+				     false, sync_lease_break);
 		}
 		sent_interim = true;
 		list_del(&ent->list);
@@ -1751,19 +1762,24 @@ static void __smb_break_all_levII_oplock(struct ksmbd_work *work,
 void smb_break_all_levII_oplock(struct ksmbd_work *work, struct ksmbd_file *fp,
