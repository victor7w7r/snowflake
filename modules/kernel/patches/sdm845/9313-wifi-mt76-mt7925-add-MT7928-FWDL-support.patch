 .../wireless/mediatek/mt76/mt76_connac_mcu.c  | 251 +++++++++++++++++-
 .../wireless/mediatek/mt76/mt76_connac_mcu.h  |  40 +++
 .../net/wireless/mediatek/mt76/mt7925/mcu.c   |  15 +-
