From f994778da4fc3a14c4102ec3afe17e1a850c5816 Mon Sep 17 00:00:00 2001
From: David Heidelberg <david@ixit.cz>
Date: Sun, 9 Aug 2026 14:04:31 +0200
Subject: [PATCH 211/212] arm64: dts: qcom: sdm845-xiaomi-dipper: Enable the
 display

Enable MDSS and DSI0 and describe the Samsung AMS621RC04 panel, which
is common to all Mi 8 variants.  The panel takes VDDIO from PM8998 L14
and VCI from a load switch on GPIO 35; LAB/IBB are unused, as the
module generates ELVDD/ELVSS internally.

TE is routed to GPIO 10, which is the DPU's first vsync GPIO input, so
the default TE source applies and no qcom,te-source is needed.

Signed-off-by: David Heidelberg <david@ixit.cz>
Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../dts/qcom/sdm845-xiaomi-dipper-common.dtsi | 75 +++++++++++++++++--
 1 file changed, 68 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sdm845-xiaomi-dipper-common.dtsi b/arch/arm64/boot/dts/qcom/sdm845-xiaomi-dipper-common.dtsi
index 7ab1ab9a0ad7..ae3c3613ad93 100644
--- a/arch/arm64/boot/dts/qcom/sdm845-xiaomi-dipper-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sdm845-xiaomi-dipper-common.dtsi
@@ -72,6 +72,20 @@ key-volume-up {
 		};
 	};
 
+	/* supplies ELVDD/ELSS to the panel */
+	vreg_panel_vci: regulator-panel-vci {
+		compatible = "regulator-fixed";
+		regulator-name = "panel_vci_vreg";
+
+		regulator-min-microvolt = <3000000>;
+		regulator-max-microvolt = <3000000>;
+
+		gpio = <&tlmm 35 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <4000>;
+		regulator-boot-on;
+	};
+
 	regulator-panel-vddio {
 		compatible = "regulator-fixed";
 		regulator-name = "panel_vddio_vreg";
@@ -393,11 +407,6 @@ vreg_bob: bob {
 	};
 };
 
-&dispcc {
-	/* Disable for now so simple-framebuffer continues working */
-	status = "disabled";
-};
-
 &gcc {
 	protected-clocks = <GCC_QSPI_CORE_CLK>,
 			   <GCC_QSPI_CORE_CLK_SRC>,
@@ -445,8 +454,44 @@ &lab {
 };
 
 &mdss {
-	/* Disable for now so simple-framebuffer continues working */
-	status = "disabled";
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l26a_1p2>;
+
+	status = "okay";
+
+	panel@0 {
+		compatible = "samsung,ea8074-ams621rc", "samsung,ea8074";
+		reg = <0>;
+
+		reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
+
+		vddio-supply = <&vreg_l14a_1p8>;
+		elvdd-supply = <&vreg_panel_vci>;
+		elvss-supply = <&vreg_panel_vci>;
+
+		pinctrl-0 = <&panel_default>;
+		pinctrl-names = "default";
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l1a_0p875>;
+
+	status = "okay";
 };
 
 &mss_pil {
@@ -520,6 +565,22 @@ &i2c14 {
 &tlmm {
 	gpio-reserved-ranges = < 0 4>, /* SPI (Goodix Fingerprint) */
 			       <81 4>; /* SPI (Synaptics Fingerprint) */
+
+	panel_default: panel-default-state {
+		reset-pins {
+			pins = "gpio6";
+			function = "gpio";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		te-pins {
+			pins = "gpio10";
+			function = "mdp_vsync";
+			drive-strength = <2>;
+			bias-pull-down;
+		};
+	};
 };
 
 &ufs_mem_hc {
-- 
2.55.0

